# Environment variable configuration example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Mini Knowledge Assistant"
DEBUG=false
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# Default is a local SQLite file. For production, use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/knowledge_db
DATABASE_URL=sqlite:///./knowledge_assistant.db

# ── Embedding model ───────────────────────────────────────────────────────────
# Local sentence-transformers model (downloaded on first run, ~90 MB)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MAX_DOCUMENT_SIZE=100000

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K_CHUNKS=5
RELEVANCE_THRESHOLD=0.3

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM generates answers: gemini (default) | openai | anthropic | demo
#   demo = offline extractive answers, NOT an LLM. Only used when you choose it
#          explicitly; the app never silently falls back to it.
LLM_PROVIDER=gemini

# Set the key for the provider you chose. Leave the others blank.
# Get a Gemini key (free tier available): https://aistudio.google.com/apikey
# NEVER commit your real .env file or paste real keys into this example file.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override the provider's default model.
# Defaults: gemini=gemini-2.5-flash, openai=gpt-4o-mini, anthropic=claude-3-5-haiku-latest
# LLM_MODEL=gemini-2.5-flash

# Per-request timeout (seconds) and retries for transient failures (timeouts, 5xx, network)
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60
